{
  "name": "cybernotepad-website",
  "private": true,
  "version": "1.0.0",
  "description": "CyberNotepad - Professional cybersecurity blog covering ethical hacking, security frameworks, and secure development practices",
  "homepage": "https://Chr-Jan.github.io/cybernotepad-website",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chr-Jan/cybernotepad-website.git"
  },
  "keywords": [
    "cybersecurity",
    "ethical-hacking",
    "penetration-testing",
    "security",
    "blog"
  ],
  "author": "CyberNotepad",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && BUILD_MODE=prod vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "install-deps": "npm install",
    "clean": "rm -rf node_modules package-lock.json",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "overrides": {
    "flatted": "^3.4.2"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.364.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "gh-pages": "^6.1.1",
    "globals": "^15.12.0",
    "postcss": "^8.5.26",
    "tailwindcss": "v3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.4.3"
  }
}
